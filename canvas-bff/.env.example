PORT=17372
NODE_ENV=development
CANVAS_ORIGIN=https://canvas.example.test
SUB2API_BASE_URL=https://sub2api.example.test
# Shared with Sub2API canvas.bff_shared_secret. Required in production.
SUB2API_CANVAS_BFF_SECRET=
# 32-byte key, encoded as 64 hex characters or base64. Required for persistent BFF runtime.
CANVAS_PROVIDER_MASTER_KEY=
# HMAC signing secret for media URLs. Replace the development fallback in production.
CANVAS_OBJECT_SIGNING_SECRET=
# Optional logical media retention cap in bytes. Oldest media is deleted after a new object is stored.
CANVAS_STORAGE_RETENTION_MAX_BYTES=
# PostgreSQL and S3-compatible storage used by the non-test BFF runtime.
DATABASE_URL=postgresql://canvas:canvas-dev-password@localhost:15432/canvas
S3_ENDPOINT=http://localhost:19000
S3_PUBLIC_ENDPOINT=http://localhost:19000
S3_REGION=us-east-1
S3_BUCKET=canvas-media
S3_ACCESS_KEY_ID=canvas
S3_SECRET_ACCESS_KEY=canvas-dev-secret
