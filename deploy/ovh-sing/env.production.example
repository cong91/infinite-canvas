# Copy to /srv/infinite-canvas/.env.production on ovh-sing and chmod 600.
# Never commit the populated file. Values are read by docker-compose.ovh.yml.
CANVAS_ORIGIN=https://canvas.v-claw.org
SUB2API_BASE_URL=https://token.v-claw.org
SUB2API_CANVAS_BFF_SECRET=replace-with-the-same-32-plus-character-value-as-sub2api
CANVAS_PROVIDER_MASTER_KEY=replace-with-64-hex-characters
CANVAS_OBJECT_SIGNING_SECRET=replace-with-a-random-32-plus-character-value

POSTGRES_DB=canvas
POSTGRES_USER=canvas
POSTGRES_PASSWORD=replace-with-a-random-password
MINIO_ROOT_USER=canvas
MINIO_ROOT_PASSWORD=replace-with-a-random-password
S3_BUCKET=canvas-media
S3_PUBLIC_ENDPOINT=https://canvas.v-claw.org/storage
S3_REGION=us-east-1
CERTBOT_EMAIL=replace-with-an-operations-email
